APP_NAME=CineSync AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STORAGE_PATH=storage
TEMP_PATH=storage/shared/temp
OUTPUT_PATH=storage/shared/outputs
LOGS_PATH=logs
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_UPLOAD_SIZE=268435456
MODEL_CACHE_DIR=models-cache
CLEANUP_ENABLED=true
TEMP_FILE_TTL_SECONDS=3600
JOB_TIMEOUT_SECONDS=1800
FFMPEG_TIMEOUT_SECONDS=600
FFMPEG_RETRY_ATTEMPTS=2

ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.avi,.png,.jpg,.jpeg,.wav,.mp3
ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska,video/x-msvideo,image/png,image/jpeg,audio/wav,audio/x-wav,audio/mpeg

AI_SERVER_URL=
MEDIA_SERVER_URL=
DATABASE_URL=postgresql+asyncpg://cinesync:secret@postgres:5432/cinesync

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CLASSIFIER_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
ENABLE_LOCAL_AI_FALLBACK=true
